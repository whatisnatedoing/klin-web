10:["$","$1","c",{"children":[["$","article",null,{"className":"wrap pb-8 pt-12 md:pt-20","children":[["$","header",null,{"className":"max-w-3xl","children":[["$","h1",null,{"className":"t-title1","children":"Because love lives in the little things."}],"$undefined"]}],["$","div",null,{"className":"mt-14 ","children":["$","div",null,{"className":"grid gap-14 lg:grid-cols-12","children":[["$","div",null,{"className":"flex max-w-prose flex-col gap-6 text-[1.1875rem] leading-[1.7] lg:col-span-6","children":[["$","p","Most relationships are not held together by anniversaries. They are held together by the text about the weather, the song sent at midnight, the photo of a bad sandwich you both still talk about.",{"children":"Most relationships are not held together by anniversaries. They are held together by the text about the weather, the song sent at midnight, the photo of a bad sandwich you both still talk about."}],["$","p","We made Klin because those things deserve somewhere to live that is not a crowded group chat or a camera roll nobody scrolls. It is a small space for two people. It will not ask you to perform and it will not keep score.",{"children":"We made Klin because those things deserve somewhere to live that is not a crowded group chat or a camera roll nobody scrolls. It is a small space for two people. It will not ask you to perform and it will not keep score."}],["$","p","It just keeps the little things close, so they are easy to find when you want them.",{"children":"It just keeps the little things close, so they are easy to find when you want them."}]]}],["$","section",null,{"aria-labelledby":"principles","className":"lg:col-span-5 lg:col-start-8","children":[["$","h2",null,{"id":"principles","className":"t-title2","children":"What we hold to"}],["$","dl",null,{"className":"mt-6 border-t border-border-subtle","children":[["$","div","Two people, nobody else",{"className":"border-b border-border-subtle py-5","children":[["$","dt",null,{"className":"font-bold","children":"Two people, nobody else"}],["$","dd",null,{"className":"mt-1 text-text-secondary","children":"A space belongs to the two of you. There is no feed, no followers and no audience."}]]}],["$","div","No guilt",{"className":"border-b border-border-subtle py-5","children":[["$","dt",null,{"className":"font-bold","children":"No guilt"}],["$","dd",null,{"className":"mt-1 text-text-secondary","children":"Streaks are off unless you turn them on. Reminders are quiet. A missed day is just a missed day."}]]}],["$","div","Honest about privacy",{"className":"border-b border-border-subtle py-5","children":[["$","dt",null,{"className":"font-bold","children":"Honest about privacy"}],["$","dd",null,{"className":"mt-1 text-text-secondary","children":"We tell you what is protected and how, including what is not. We will not describe Klin as end-to-end encrypted unless it is."}]]}],["$","div","Yours to take with you",{"className":"border-b border-border-subtle py-5","children":[["$","dt",null,{"className":"font-bold","children":"Yours to take with you"}],["$","dd",null,{"className":"mt-1 text-text-secondary","children":"You can export what you have saved, and you can delete your account."}]]}]]}]]}]]}]}]]}],null,["$","$L16",null,{"children":["$","$17",null,{"name":"Next.MetadataOutlet","children":"$@18"}]}]]}]
