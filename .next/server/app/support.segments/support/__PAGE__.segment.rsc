18:["$","details","Is our information private?",{"className":"group border-b border-border-subtle","children":[["$","summary",null,{"className":"flex items-start justify-between gap-6 py-5 text-[1.1875rem] font-medium leading-snug","children":[["$","span",null,{"children":"Is our information private?"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] grid h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:hidden","children":"+"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] hidden h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:grid","children":"−"}]]}],["$","p",null,{"className":"max-w-prose pb-6 pr-10 text-text-secondary","children":"Only the two people in a space can open its messages, photos, memories and shared journals. Private diary entries and private mood notes are visible only to the person who wrote them. Your data is encrypted in transit and at rest. Klin is not end-to-end encrypted, which means our servers process your content to run the app, and we would rather tell you that plainly. Klin’s admin tools show account details, not your conversations. The Privacy page has the full detail."}]]}]
19:["$","details","Can I use Klin on Android and iPhone?",{"className":"group border-b border-border-subtle","children":[["$","summary",null,{"className":"flex items-start justify-between gap-6 py-5 text-[1.1875rem] font-medium leading-snug","children":[["$","span",null,{"children":"Can I use Klin on Android and iPhone?"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] grid h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:hidden","children":"+"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] hidden h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:grid","children":"−"}]]}],["$","p",null,{"className":"max-w-prose pb-6 pr-10 text-text-secondary","children":"Yes. Klin is one app, built for both iPhone and Android."}]]}]
1a:["$","details","Can I leave a relationship space?",{"className":"group border-b border-border-subtle","children":[["$","summary",null,{"className":"flex items-start justify-between gap-6 py-5 text-[1.1875rem] font-medium leading-snug","children":[["$","span",null,{"children":"Can I leave a relationship space?"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] grid h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:hidden","children":"+"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] hidden h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:grid","children":"−"}]]}],["$","p",null,{"className":"max-w-prose pb-6 pr-10 text-text-secondary","children":"Yes, whenever you like. Klin shows you exactly what happens first. Shared items become read-only for 30 days so you can export them, and your private diary and mood notes stay yours."}]]}]
1b:["$","details","What is Klin Plus?",{"className":"group border-b border-border-subtle","children":[["$","summary",null,{"className":"flex items-start justify-between gap-6 py-5 text-[1.1875rem] font-medium leading-snug","children":[["$","span",null,{"children":"What is Klin Plus?"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] grid h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:hidden","children":"+"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] hidden h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:grid","children":"−"}]]}],["$","p",null,{"className":"max-w-prose pb-6 pr-10 text-text-secondary","children":"An optional subscription that gives you more storage, advanced recaps and reminders, custom themes, a higher daily limit for the assistant and anniversary experiences. If either of you subscribes, it covers both of you."}]]}]
1c:["$","details","Can I delete my account?",{"className":"group border-b border-border-subtle","children":[["$","summary",null,{"className":"flex items-start justify-between gap-6 py-5 text-[1.1875rem] font-medium leading-snug","children":[["$","span",null,{"children":"Can I delete my account?"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] grid h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:hidden","children":"+"}],["$","span",null,{"aria-hidden":"true","className":"mt-[0.2em] hidden h-5 w-5 shrink-0 place-items-center text-xl leading-none text-text-secondary group-open:grid","children":"−"}]]}],["$","p",null,{"className":"max-w-prose pb-6 pr-10 text-text-secondary","children":"Yes. Go to Profile, then Account, then Delete account. You confirm with your password, and there is a 14 day window to change your mind before your data is removed. Subscriptions are managed in the App Store or Google Play and are not cancelled automatically."}]]}]
1d:["$","div",null,{"className":"flex flex-col gap-14 lg:col-span-4 lg:col-start-9","children":[["$","section",null,{"id":"contact","aria-labelledby":"contact-title","children":[["$","h2",null,{"id":"contact-title","className":"t-title2","children":"Contact"}],["$","p",null,{"className":"mt-3 text-text-secondary","children":"Support opens when Klin does. A contact address will be here."}]]}],["$","section",null,{"id":"delete-account","aria-labelledby":"delete-title","children":[["$","h2",null,{"id":"delete-title","className":"t-title2","children":"Delete your account"}],["$","p",null,{"className":"mt-3 text-text-secondary","children":"You can delete your account in the app, any time."}],["$","ol",null,{"className":"mt-4 list-decimal space-y-2 pl-5","children":[["$","li",null,{"children":"Open Klin and go to Profile."}],["$","li",null,{"children":"Choose Account, then Delete account."}],["$","li",null,{"children":"Read what will happen and confirm with your password."}]]}],["$","p",null,{"className":"mt-4 text-text-secondary","children":"Your account is switched off straight away. For 14 days you can sign back in to change your mind. After that your personal data is removed. Subscriptions are managed in the App Store or Google Play and are not cancelled automatically."}],""]}]]}]
26:Tb44,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Klin?","acceptedAnswer":{"@type":"Answer","text":"Klin is a private app for two people. Talk, share photos and videos, keep memories, plan dates, write letters and keep journals, all in one shared space."}},{"@type":"Question","name":"Is Klin free?","acceptedAnswer":{"@type":"Answer","text":"Yes, to start. Free covers pairing, messaging, a basic memory vault, the shared calendar, daily questions and basic journaling. Klin Plus adds more room and some extras."}},{"@type":"Question","name":"How do I invite my partner?","acceptedAnswer":{"@type":"Answer","text":"Create your space and Klin gives you a code and a link. Send either one. Your partner signs up or logs in, looks over the invitation and chooses to join. Each invitation works once and expires after seven days."}},{"@type":"Question","name":"Can we use Klin long-distance?","acceptedAnswer":{"@type":"Answer","text":"Yes. Klin shows each of you the other’s local time, counts down to your next visit, suggests things to do apart and can schedule messages and letters to arrive at the right moment."}},{"@type":"Question","name":"Is our information private?","acceptedAnswer":{"@type":"Answer","text":"Only the two people in a space can open its messages, photos, memories and shared journals. Private diary entries and private mood notes are visible only to the person who wrote them. Your data is encrypted in transit and at rest. Klin is not end-to-end encrypted, which means our servers process your content to run the app, and we would rather tell you that plainly. Klin’s admin tools show account details, not your conversations. The Privacy page has the full detail."}},{"@type":"Question","name":"Can I use Klin on Android and iPhone?","acceptedAnswer":{"@type":"Answer","text":"Yes. Klin is one app, built for both iPhone and Android."}},{"@type":"Question","name":"Can I leave a relationship space?","acceptedAnswer":{"@type":"Answer","text":"Yes, whenever you like. Klin shows you exactly what happens first. Shared items become read-only for 30 days so you can export them, and your private diary and mood notes stay yours."}},{"@type":"Question","name":"What is Klin Plus?","acceptedAnswer":{"@type":"Answer","text":"An optional subscription that gives you more storage, advanced recaps and reminders, custom themes, a higher daily limit for the assistant and anniversary experiences. If either of you subscribes, it covers both of you."}},{"@type":"Question","name":"Can I delete my account?","acceptedAnswer":{"@type":"Answer","text":"Yes. Go to Profile, then Account, then Delete account. You confirm with your password, and there is a 14 day window to change your mind before your data is removed. Subscriptions are managed in the App Store or Google Play and are not cancelled automatically."}}]}1e:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$26"}}]
